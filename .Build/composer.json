{
  "name": "derhansen/sf_event_mgt_build",
  "description": "composer.json for builds",
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "path",
      "url": "../"
    }
  ],
  "require": {
    "php": ">=8.2",
    "derhansen/sf_event_mgt": "@dev",
    "typo3/cms-core": "^14.0"
  },
  "require-dev": {
    "typo3/cms-composer-installers": "^5.0",

    "typo3/cms-backend": "^14.0",
    "typo3/cms-frontend": "^14.0",
    "typo3/cms-extbase": "^14.0",
    "typo3/cms-felogin": "^14.0",
    "typo3/cms-fluid-styled-content": "^14.0",
    "typo3/cms-fluid": "^14.0",
    "typo3/cms-tstemplate": "^14.0",
    "typo3/cms-install": "^14.0",
    "typo3/cms-extensionmanager": "^14.0",

    "typo3/testing-framework": "^9.0",

    "friendsofphp/php-cs-fixer": "^3.12",
    "phpstan/extension-installer": "^1.3",

    "codeception/codeception": "^5.0",
    "codeception/module-webdriver": "^4.0",
    "codeception/module-db": "^3.1",
    "koehnlein/codeception-email-mailpit": "^0.3.0"
  },
  "config": {
    "lock": false,
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "phpstan/extension-installer": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DERHANSEN\\SfEventMgt\\Tests\\": "../Tests"
    }
  }
}
